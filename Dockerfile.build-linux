# Container build environment for OrcSpace Linux installer
FROM node:24-bookworm-slim

# Install system dependencies required for native compilation & packaging (.deb, AppImage)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    pkg-config \
    libasound2-dev \
    libclang-dev \
    libfontconfig1-dev \
    libgtk-3-dev \
    libsecret-1-dev \
    libssl-dev \
    libwayland-dev \
    libxkbcommon-dev \
    libxcb-render0-dev \
    libxcb-shape0-dev \
    libxcb-xfixes0-dev \
    libx11-dev \
    libxkbfile-dev \
    libxcursor-dev \
    libxi-dev \
    libxinerama-dev \
    libxrandr-dev \
    libgl1 \
    libxi6 \
    fakeroot \
    dpkg \
    xvfb \
    curl \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Electron's bundled runtime needs NSS/NSPR even when building in a headless container.
RUN apt-get update && apt-get install -y --no-install-recommends libnss3 xauth \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain for native engine / sidecar
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app

# Install dependencies first for Docker caching
COPY package*.json ./
COPY scripts/patch-pty.mjs ./scripts/patch-pty.mjs
RUN npm ci --no-audit --no-fund

# Copy source tree
COPY . .

RUN chmod +x build-linux.sh setup.sh

# Build Linux installers (AppImage, deb)
CMD ["bash", "-c", "node scripts/build-installer-linux.mjs --all --skip-ci --dirty"]
