#!/bin/sh
# macOS / Linux / Windows (Git Bash/MSYS2) shim for the GraySpace agent CLI.
#
# GRAYSPACE_NODE points at the app node runtime if set.
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
native_bin="$dir/../native/target/release/grayspace"
if [ -x "$native_bin" ]; then
  exec "$native_bin" "$@"
fi
case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*)
    if command -v cygpath >/dev/null 2>&1; then
      script_path=$(cygpath -w "$dir/grayspace.mjs")
    else
      script_path="$dir/grayspace.mjs"
    fi
    ;;
  *)
    script_path="$dir/grayspace.mjs"
    ;;
esac
exec "${GRAYSPACE_NODE:-node}" "$script_path" "$@"
