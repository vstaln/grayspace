{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/shared/**/*",
    "src/preload/**/*",
    "src/renderer/src/lib/frameMetrics.ts",
    "src/renderer/src/lib/sanitizeUrl.ts",
    "src/renderer/src/lib/canvasMetrics.ts",
    "src/renderer/src/lib/commandInput.ts",
    "src/renderer/src/lib/terminalRenderQueue.ts",
    "src/renderer/src/lib/terminalRenderQueue.test.ts",
    "src/renderer/src/types.ts",
    "src/renderer/src/lib/music.ts",
    "src/renderer/src/lib/paste.ts",
    "src/renderer/src/lib/terminalAttachments.ts",
    "src/renderer/src/lib/pendingTerminalCommands.ts",
    "src/renderer/src/lib/boundedCache.ts"
  ]
}
