{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // core/ is executed directly by `node --test` through Node's type
    // stripping, whose ESM resolver needs the real extension on every
    // relative import. Vite resolves the same specifiers unchanged.
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/renderer/src/lib/markdown.ts",
    "src/renderer/src/lib/sanitizeUrl.ts",
    "src/renderer/src/lib/canvasMetrics.ts",
    "src/renderer/src/lib/music.ts",
    "src/renderer/src/lib/paste.ts"
  ]
}
