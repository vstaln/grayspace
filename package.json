{
  "name": "orcspace",
  "version": "2.0.8",
  "description": "OrcSpace — an infinite canvas with terminals, notes and agent coordination",
  "type": "module",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": "OrcSpace",
  "engines": {
    "node": "20.x || 22.x || 24.x || 26.x"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "postinstall": "node scripts/patch-pty.mjs",
    "predev": "node scripts/ensure-native-engine.mjs",
    "dev": "npm run build:native && electron-vite dev",
    "dev:native": "npm run native:run",
    "build:native": "node native/build.mjs",
    "native:check": "node scripts/native-cargo.mjs check --manifest-path native/Cargo.toml",
    "native:run": "node scripts/native-cargo.mjs run --bin orcspace --manifest-path native/orcspace-app/Cargo.toml",
    "native:build": "node scripts/native-cargo.mjs build --release --bins --manifest-path native/orcspace-app/Cargo.toml",
    "native:start": "node scripts/native-cargo.mjs run --release --bin orcspace --manifest-path native/orcspace-app/Cargo.toml",
    "prebuild": "node scripts/ensure-native-engine.mjs",
    "build": "npm run build:native && electron-vite build",
    "build:electron": "npm run build",
    "start": "electron-vite preview",
    "start:native": "npm run native:start",
    "reset": "node scripts/reset.mjs",
    "test": "node --test --test-concurrency=1 \"src/main/**/*.test.ts\" \"src/renderer/src/lib/*.test.ts\"",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:native": "npm run native:build",
    "dist:electron": "npm run dist",
    "installer:win": "node scripts/build-installer.mjs --skip-ci --dirty",
    "dist:mac": "npm run build:electron && electron-builder --mac --publish never",
    "dist:mac:arm": "npm run build:electron && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac:intel": "npm run build:electron && electron-builder --mac dmg zip --x64 --publish never",
    "dist:mac:dmg": "npm run build:electron && electron-builder --mac dmg --publish never",
    "pack:archive": "node scripts/pack-archive.mjs",
    "smoke": "node scripts/smoke.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test --project=local",
    "test:e2e:ui": "playwright test --project=local --ui",
    "test:e2e:ci": "playwright test --project=ci"
  },
  "build": {
    "appId": "com.orcspace.app",
    "productName": "OrcSpace",
    "publish": {
      "provider": "github",
      "owner": "orcspace",
      "repo": "Orcspace-Uptade",
      "releaseType": "release"
    },
    "npmRebuild": false,
    "afterSign": "scripts/notarize.mjs",
    "afterPack": "scripts/release-security.cjs",
    "asar": true,
    "files": [
      "out/**/*",
      "!**/*.{map,ts,mts,cts,tsx,rs,pdb,pem,key,p12,pfx}",
      "!**/.env*",
      "!**/.git/**/*",
      "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/prebuilds/{linux-arm,linux-arm64,linux-ia32,linux-x64}/**/*",
      "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/third_party/conpty/*/win10-arm64/**/*",
      "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/build/**/*.{iobj,ipdb,tlog,pdb,exp,lib,lastbuildstate}",
      "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/deps/**/*",
      "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/src/**/*",
      "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/scripts/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/@homebridge/node-pty-prebuilt-multiarch/**/*"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "extraResources": [
      {
        "from": "cli",
        "to": "cli",
        "filter": [
          "orc",
          "orc.mjs",
          "orc.cmd",
          "orc.bat"
        ]
      },
      {
        "from": "native/canvas-core",
        "to": "native/canvas-core",
        "filter": [
          "loader.cjs",
          "package.json",
          "*.node"
        ]
      },
      {
        "from": "native/storage-core",
        "to": "native/storage-core",
        "filter": [
          "loader.cjs",
          "package.json",
          "*.node"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icons/orc-logo.ico",
      "extraResources": [
        {
          "from": "native/target/release/orcspace.exe",
          "to": "native/orcspace-engine.exe"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/icons/orc-logo-1024.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "OrcSpace does not use the camera.",
        "NSMicrophoneUsageDescription": "OrcSpace does not use the microphone.",
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "assets/icons/orc-logo-1024.png",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OrcSpace",
      "installerIcon": "assets/icons/orc-logo.ico",
      "uninstallerIcon": "assets/icons/orc-logo.ico",
      "installerHeaderIcon": "assets/icons/orc-logo.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "multiLanguageInstaller": false,
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@electron/notarize": "^3.1.1",
    "@homebridge/node-pty-prebuilt-multiarch": "0.13.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "@xterm/addon-unicode11": "^0.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@napi-rs/cli": "^3.4.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "lucide-react": "^1.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "unocss": "^66.8.1",
    "vite": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
