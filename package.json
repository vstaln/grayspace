{
  "name": "grayspace",
  "version": "0.0.1",
  "description": "GraySpace \u2014 an infinite canvas for terminals and agent coordination",
  "type": "module",
  "license": "MIT",
  "author": "GraySpace",
  "homepage": "https://github.com/vstaln/GraySpace",
  "engines": {
    "node": ">=22.18.0 <23 || >=24.0.0 <25"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "0.13.1"
  },
  "scripts": {
    "native:check": "node scripts/native-cargo.mjs check --manifest-path native/Cargo.toml",
    "native:run": "node scripts/native-cargo.mjs run --bin grayspace --manifest-path native/grayspace-app/Cargo.toml",
    "native:build": "node scripts/native-cargo.mjs build --release --bin grayspace --manifest-path native/grayspace-app/Cargo.toml",
    "native:start": "node scripts/native-cargo.mjs run --release --bin grayspace --manifest-path native/grayspace-app/Cargo.toml",
    "smoke": "node scripts/smoke.mjs",
    "check:version": "node scripts/check-version.mjs",
    "test": "node scripts/check-version.mjs && node scripts/native-cargo.mjs test --manifest-path native/Cargo.toml -p grayspace-app --lib --locked"
  }
}
