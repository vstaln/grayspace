{
  "name": "grayspace",
  "version": "0.0.1",
  "description": "GraySpace \u2014 an infinite canvas for terminals and agent coordination",
  "type": "module",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": "GraySpace",
  "homepage": "https://github.com/vstaln/GraySpace",
  "engines": {
    "node": ">=22.18.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "postinstall": "node scripts/patch-pty.mjs",
    "predev": "node scripts/ensure-native-engine.mjs",
    "dev": "npm run build:native && electron-vite dev",
    "dev:native": "npm run native:run",
    "build:native": "node native/build.mjs",
    "native:check": "node scripts/native-cargo.mjs check --manifest-path native/Cargo.toml",
    "native:run": "node scripts/native-cargo.mjs build --bin orc --manifest-path native/orcspace-app/Cargo.toml && node scripts/native-cargo.mjs run --bin orcspace --manifest-path native/orcspace-app/Cargo.toml",
    "native:build": "node scripts/native-cargo.mjs build --release --bins --manifest-path native/orcspace-app/Cargo.toml",
    "native:start": "node scripts/native-cargo.mjs build --release --bin orc --manifest-path native/orcspace-app/Cargo.toml && node scripts/native-cargo.mjs run --release --bin orcspace --manifest-path native/orcspace-app/Cargo.toml",
    "prebuild": "node scripts/ensure-native-engine.mjs",
    "build": "npm run build:native && electron-vite build",
    "build:electron": "npm run build",
    "start": "electron-vite preview",
    "start:native": "npm run native:start",
    "reset": "node scripts/reset.mjs",
    "check:version": "node scripts/check-version.mjs",
    "pretest": "npm run check:version",
    "test": "node --test --test-concurrency=1 \"src/main/**/*.test.ts\" \"src/renderer/src/lib/**/*.test.ts\" scripts/release-security.test.cjs && node scripts/native-cargo.mjs test --workspace --manifest-path native/Cargo.toml --locked",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "dist": "node scripts/build-installer.mjs",
    "dist:native": "npm run native:build",
    "dist:electron": "npm run dist",
    "installer:win": "node scripts/build-installer.mjs",
    "dist:mac": "npm run build:electron && electron-builder --mac --publish never",
    "dist:mac:arm": "npm run build:electron && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac:intel": "npm run build:electron && electron-builder --mac dmg zip --x64 --publish never",
    "dist:mac:dmg": "npm run build:electron && electron-builder --mac dmg --publish never",
    "dist:linux": "node scripts/build-installer-linux.mjs",
    "dist:linux:appimage": "node scripts/build-installer-linux.mjs --appimage",
    "dist:linux:deb": "node scripts/build-installer-linux.mjs --deb",
    "dist:linux:tar": "node scripts/build-installer-linux.mjs --tar",
    "installer:linux": "node scripts/build-installer-linux.mjs",
    "smoke": "node scripts/smoke.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test --project=local",
    "test:e2e:ui": "playwright test --project=local --ui",
    "test:e2e:ci": "playwright test --project=ci"
  },
  "build": {
    "appId": "com.grayspace.app",
    "productName": "GraySpace",
    "publish": {
      "provider": "github",
      "owner": "vstaln",
      "repo": "GraySpace",
      "releaseType": "release"
    },
    "npmRebuild": false,
    "afterSign": "scripts/notarize.mjs",
    "afterPack": "scripts/release-security.cjs",
    "asar": true,
    "files": [
      "out/**/*",
      "!**/*.{map,ts,mts,cts,tsx,rs,pdb,pem,key,p12,pfx}",
      "!**/.env*",
      "!**/.git/**/*",
      "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/third_party/conpty/*/win10-arm64/**/*",
      "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/prebuilds/linux-arm/**/*",
      "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/prebuilds/linux-arm64/**/*",
      "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/prebuilds/linux-ia32/**/*",
      "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/prebuilds/linux-x64/*.musl.node",
      "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/build/**/*.{iobj,ipdb,tlog,pdb,exp,lib,lastbuildstate}",
      "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/deps/**/*",
      "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/src/**/*",
      "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/scripts/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/@homebridge/node-pty-prebuilt-multiarch/**/*"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "extraResources": [
      {
        "from": "cli",
        "to": "cli",
        "filter": [
          "orc",
          "orc.mjs",
          "orc.cmd",
          "orc.bat"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icons/orc-logo.ico",
      "extraResources": [
        {
          "from": "native/target/release/orcspace.exe",
          "to": "native/orcspace-engine.exe"
        },
        {
          "from": "native/canvas-core",
          "to": "native/canvas-core",
          "filter": [
            "loader.cjs",
            "package.json",
            "index.win32-x64-msvc.node"
          ]
        },
        {
          "from": "native/storage-core",
          "to": "native/storage-core",
          "filter": [
            "loader.cjs",
            "package.json",
            "index.win32-x64-msvc.node"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "out/**/*",
        "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/prebuilds/{linux-arm,linux-arm64,linux-ia32,linux-x64,darwin-arm64,darwin-x64}/**/*"
      ]
    },
    "mac": {
      "icon": "assets/icons/orc-logo-1024.png",
      "extraResources": [
        {
          "from": "native/canvas-core",
          "to": "native/canvas-core",
          "filter": [
            "loader.cjs",
            "package.json",
            "index.darwin-*.node"
          ]
        },
        {
          "from": "native/storage-core",
          "to": "native/storage-core",
          "filter": [
            "loader.cjs",
            "package.json",
            "index.darwin-*.node"
          ]
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "OrcSpace does not use the camera.",
        "NSMicrophoneUsageDescription": "OrcSpace does not use the microphone.",
        "CFBundleDevelopmentRegion": "en"
      },
      "files": [
        "out/**/*",
        "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/prebuilds/{linux-arm,linux-arm64,linux-ia32,linux-x64,win32-arm64,win32-ia32,win32-x64}/**/*",
        "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/third_party/conpty/**/*"
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "assets/icons/orc-logo-1024.png",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OrcSpace",
      "installerIcon": "assets/icons/orc-logo.ico",
      "uninstallerIcon": "assets/icons/orc-logo.ico",
      "installerHeaderIcon": "assets/icons/orc-logo.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "multiLanguageInstaller": false,
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033"
    },
    "linux": {
      "executableName": "orcspace",
      "icon": "assets/icons/orc-logo-512.png",
      "category": "Utility;Development;",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "out/**/*",
        "!**/*.{map,ts,mts,cts,tsx,rs,pdb,pem,key,p12,pfx}",
        "!**/.env*",
        "!**/.git/**/*",
        "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/build/**/*.{iobj,ipdb,tlog,pdb,exp,lib,lastbuildstate}",
        "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/deps/**/*",
        "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/src/**/*",
        "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/scripts/**/*",
        "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/prebuilds/{darwin-arm64,darwin-x64,win32-arm64,win32-ia32,win32-x64}/**/*",
        "!**/node_modules/@homebridge/node-pty-prebuilt-multiarch/third_party/conpty/**/*"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "synopsis": "An infinite canvas for terminals and agent coordination",
      "description": "OrcSpace is an infinite canvas workspace for running interactive terminals and coordinating autonomous agents.",
      "maintainer": "OrcSpace <support@orcspace.app>",
      "extraResources": [
        {
          "from": "native/target/release/orcspace",
          "to": "native/orcspace-engine"
        },
        {
          "from": "native/canvas-core",
          "to": "native/canvas-core",
          "filter": [
            "loader.cjs",
            "package.json",
            "index.linux-x64-gnu.node"
          ]
        },
        {
          "from": "native/storage-core",
          "to": "native/storage-core",
          "filter": [
            "loader.cjs",
            "package.json",
            "index.linux-x64-gnu.node"
          ]
        }
      ]
    },
    "deb": {
      "priority": "optional",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64"
      ],
      "packageCategory": "utils"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@electron/notarize": "^3.1.1",
    "@homebridge/node-pty-prebuilt-multiarch": "0.13.1",
    "@xterm/addon-unicode11": "^0.9.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "puppeteer-core": "^25.12.0"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@napi-rs/cli": "^3.4.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "lucide-react": "^1.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "unocss": "^66.8.1",
    "vite": "^6.0.0"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
