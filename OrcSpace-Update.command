#!/bin/bash
# OrcSpace self-updating installer — double-click (or `bash OrcSpace-Update.command`)
# to drop the latest source in place and launch it. Everything the app needs is
# embedded below as base64; nothing is downloaded over the network.
set -e

echo "OrcSpace update — unpacking..."

DEST="$HOME/Desktop/OrcSpace"
SCRIPT_PATH="$0"
PAYLOAD_LINE=$(grep -an '^__PAYLOAD_BELOW__$' "$SCRIPT_PATH" | head -1 | cut -d: -f1)
if [ -z "$PAYLOAD_LINE" ]; then
  echo "This file is corrupted (no payload marker found). Re-download it and try again."
  read -r -p "Press Enter to close..." _
  exit 1
fi

TMPZIP="$(mktemp -t orcspace-update).zip"
tail -n +"$((PAYLOAD_LINE + 1))" "$SCRIPT_PATH" | base64 -d > "$TMPZIP"

if [ -d "$DEST" ]; then
  BACKUP="$HOME/Desktop/OrcSpace-backup-$(date +%Y%m%d-%H%M%S)"
  echo "Found an existing OrcSpace folder — moving it to $(basename "$BACKUP") first, nothing is deleted."
  mv "$DEST" "$BACKUP"
fi

unzip -q "$TMPZIP" -d "$HOME/Desktop"
rm -f "$TMPZIP"
cd "$DEST"

if ! command -v npm >/dev/null 2>&1; then
  echo ""
  echo "Node.js/npm is not installed. Install it from https://nodejs.org (LTS version),"
  echo "then open Terminal, run: cd ~/Desktop/OrcSpace && npm install && npm run dev"
  read -r -p "Press Enter to close..." _
  exit 1
fi

echo "Installing dependencies (first run only — this can take a few minutes)..."
npm install

echo "Launching OrcSpace..."
npm run dev
exit 0
__PAYLOAD_BELOW__
